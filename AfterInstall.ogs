[main]
	//	Install the sidecar's Python dependencies into the app's vendor\ folder
	//	using Origin's bundled python.exe + pip (driven by manage.py setup).
	//	Origin's PyPackage ships originpro but NOT OriginExt/comtypes (needed for
	//	EXTERNAL op.attach() over COM) nor the MCP stack, so we install them here.
	//	If the action variable does not propagate, manage.py defaults to "toggle",
	//	which also triggers the same dependency install on first start.
	MCP_ACTION$ = "setup";
	run -pyf "%@A%@X\manage.py";
	return;
