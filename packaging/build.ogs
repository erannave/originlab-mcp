[main]
	//	Build OriginMCP.opx from the repo, without packaging the live app folder.
	//
	//	Run from Origin's Script Window:
	//	  run.section("C:\Users\<user>\AppData\Local\OriginLab\Apps\OriginMCP\packaging\build.ogs", main);
	//
	//	Paths are written as %@A + OriginMCP (Apps root + app folder) rather than
	//	%@A%@X: %@X is only set while Origin is running the app, and this script
	//	is invoked by hand.
	//
	//	Three steps:
	//	  1. stage.py copies the shipped files + packaging\package.ini into a
	//	     clean temp folder named OriginMCP -- mkOPX packs the WHOLE folder
	//	     that holds package.ini, so vendor\, .git\, __pycache__\ and the
	//	     runtime artifacts must not be anywhere in it -- and then chdir()s
	//	     Origin into that folder;
	//	  2. mkOPX builds the OPX from the CURRENT FOLDER;
	//	  3. stage.py restores Origin's working directory.
	//
	//	*** Do NOT "simplify" step 2 by passing ini:= . ***
	//	mkOPX only stores RELATIVE paths (`OriginMCP\launch.ogs`, matching every
	//	shipped app) in the no-ini/no-app branch, which derives the base from the
	//	parent of _getcwd(). With ini:= that base is NULL and every file is stored
	//	as its full source path minus the drive letter -- the installer then
	//	recreates Apps\Users\<user>\AppData\Local\Temp\... and the app folder
	//	gets NOTHING: no icon, and clicking the app does nothing. Shipped once.
	//
	//	The OPX lands in the User Files Folder (%Y), NOT inside the app folder:
	//	installing an OPX that sits under Apps\OriginMCP\ means asking Origin to
	//	overwrite the folder the package file itself lives in.
	MCP_PKG_OK = 0;
	MCP_PKG_DIR$ = "";
	MCP_PKG_STEP$ = "stage";
	run -pyf "%@AOriginMCP\packaging\stage.py";
	if( MCP_PKG_OK != 1 )
	{
		type -b "OriginMCP package: staging failed - nothing was built.";
		return;
	}

	//	act:=0 -> make the OPX (act:=1 would instead rewrite package.ini).
	//	No ini:= on purpose -- see above. mkOPX reads package.ini from the cwd.
	string strOpx$ = "%YOriginMCP.opx";
	mkOPX act:=0 opx:=strOpx$;

	MCP_PKG_STEP$ = "restore";
	run -pyf "%@AOriginMCP\packaging\stage.py";
	MCP_PKG_STEP$ = "";
	return;
